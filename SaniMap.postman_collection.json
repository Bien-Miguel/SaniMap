{
  "info": {
    "_postman_id": "5637bd9a-271a-48a5-a0a8-134d1ecaa001",
    "name": "SaniMap API",
    "description": "Smoke and integration requests for the current SaniMap API Gateway. Set adminToken and managerToken collection variables to short-lived local test tokens before running protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "restroomId",
      "value": "1"
    },
    {
      "key": "reportId",
      "value": "501"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Gateway is healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "All services health (staff)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{managerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Gateway and both services are healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.gateway).to.eql('UP');",
                  "  pm.expect(body.services.registry_service.status).to.eql('UP');",
                  "  pm.expect(body.services.reporting_service.status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Registry",
      "item": [
        {
          "name": "List restrooms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/restrooms"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Restroom list is returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const records = pm.response.json();",
                  "  pm.expect(records).to.be.an('array').that.is.not.empty;",
                  "  pm.collectionVariables.set('restroomId', String(records[0].restroomId));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get restroom",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restrooms/{{restroomId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Restroom details are returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(String(pm.response.json().restroomId)).to.eql(String(pm.collectionVariables.get('restroomId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create restroom (admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Comfort Room {{$guid}}\",\n  \"latitude\": 14.582,\n  \"longitude\": 120.979,\n  \"operatingHours\": \"06:00-20:00\",\n  \"pwdAccessible\": true,\n  \"genderType\": \"Unisex\",\n  \"amenities\": [\"Handwashing Station\", \"Soap\"],\n  \"status\": \"open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/restrooms"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Restroom was created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('createdRestroomId', String(pm.response.json().restroomId));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update restroom status (admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/restrooms/{{restroomId}}/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status was updated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('open');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "Submit feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restroomId\": {{restroomId}},\n  \"reportType\": \"OTHER\",\n  \"description\": \"Postman integration smoke test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/feedback"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Feedback report was created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const report = pm.response.json();",
                  "  pm.expect(report.status).to.eql('PENDING');",
                  "  pm.collectionVariables.set('reportId', String(report.reportId));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Feedback history (staff)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{managerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/feedback/{{restroomId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Feedback history is returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get report",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/feedback/reports/{{reportId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Report is returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(String(pm.response.json().reportId)).to.eql(String(pm.collectionVariables.get('reportId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid report type (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restroomId\": {{restroomId}},\n  \"reportType\": \"NOT_A_REAL_TYPE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/feedback"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid report type is rejected', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Geocoding (optional external service)",
      "item": [
        {
          "name": "Search Luneta",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/geocode?q=Rizal%20Park%2C%20Manila",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "geocode"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "Rizal Park, Manila"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Geocoding returned a success or a documented upstream error', function () {",
                  "  pm.expect([200, 429, 502, 503]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
