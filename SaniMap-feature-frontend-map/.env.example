JWT_SECRET=
JWT_ISSUER=sanimap-gateway
JWT_AUDIENCE=sanimap-api

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=5000
GATEWAY_DEBUG=0
TRUSTED_PROXY_COUNT=0

SANIMAP_REGISTRY_URL=http://127.0.0.1:5001
SANIMAP_REPORTING_URL=http://127.0.0.1:5002
SANIMAP_REGISTRY_DB=services/service_a/registry.db
SANIMAP_REPORTING_DB=services/service_b/reporting.db

# Comma-separated exact browser origins allowed to call the Gateway.
# Set this to the deployed frontend origin in Railway (no trailing slash).
SANIMAP_CORS_ORIGINS=

ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice/v2
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
SANIMAP_CONTACT_EMAIL=